generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Barang {
  id         Int         @id @default(autoincrement())
  kode       String      @unique
  nama       String
  kategori   String
  lokasi     String
  jumlah     Int
  kondisi    String
  tahun      Int
  harga      Int
  sumberDana String
  createdAt  DateTime    @default(now())
  perawatan  Perawatan[]
}

model Perawatan {
  id         Int      @id @default(autoincrement())
  barangId   Int
  tanggal    DateTime
  jenis      String
  biaya      Int
  keterangan String
  barang     Barang   @relation(fields: [barangId], references: [id], onDelete: Cascade)
}
